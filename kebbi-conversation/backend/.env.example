LLM_PROVIDER=mock
# Live mode: set LLM_PROVIDER=openai and fill these on the server only.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=20
# Optional shared backend access token, separate from the LLM provider key.
BACKEND_TOKEN=
SESSION_TTL_SECONDS=900
MAX_SESSIONS=128
HISTORY_TURNS=6
LOG_ENABLED=true
LOG_CONTENT=false
