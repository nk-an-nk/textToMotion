# Backend only. Copy values into the launching shell or use start-conversation scripts.
OPENAI_API_KEY=
OPENAI_REALTIME_ENABLED=0
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_API_BUDGET_USD=0
OPENAI_SESSION_ALLOWANCE_USD=1
OPENAI_SESSION_SECONDS=60
OPENAI_MAX_CALLS=3
OPENAI_TEXT_FIRST_ENABLED=0
OPENAI_PLANNER_MODEL=gpt-4.1-mini
# Optional independent private-LAN GPU service. Tokens stay on the backend.
MOTION_SERVICE_URL=
MOTION_SERVICE_TOKEN=
MOTION_SERVICE_ACCESS_TOKEN=
